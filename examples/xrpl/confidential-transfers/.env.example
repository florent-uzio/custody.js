# Copy this file to `.env` in this directory and fill in the values for
# your own Ripple Custody instance. `.env` is git-ignored; this file is not, so
# never put real credentials in it.

# Ripple Custody API base URL (a devbox with confidential MPTs enabled)
API_URL=https://custody-api-url

# OAuth token endpoint of the same instance
AUTH_URL=https://custody-auth-url/token

# API user keypair used to sign requests (private key is a secret)
PRIVATE_KEY=your-api-private-key
PUBLIC_KEY=your-api-public-key

# Domain the four accounts belong to
DOMAIN_ID=00000000-0000-0000-0000-000000000000

# Custody ledger to create the accounts on. Optional, defaults to xrpl-custody-devnet
LEDGER_ID=

# Vault holding the keys of new accounts. Optional, defaults to the first vault
VAULT_ID=

# XRPL node and faucet
XRPL_WSS_URL=
FAUCET_HOST=

# Existing, funded custody account (r-address) that pays new accounts their XRP
# instead of the faucet. Optional; useful when the faucet is down.
FUNDER_ADDRESS=

# Existing accounts to reuse (XRPL r-addresses). Leave empty to create new ones;
# the script prints the lines to paste here after creating them.
ISSUER_ADDRESS=
AUDITOR_ADDRESS=
ALICE_ADDRESS=
BOB_ADDRESS=

# "true" to log every SDK request. Optional.
DEBUG=false
