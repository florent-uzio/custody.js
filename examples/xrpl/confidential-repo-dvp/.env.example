
# Copy this file to `.env` (root or this directory, see the readme "Run" section) 
# and fill in the values for your own Ripple Custody instance. `.env` 
# is git-ignored; this file is not, so never put real credentials in it.

# Ripple Custody API base URL
API_URL=https://custody-api-url

# OAuth token endpoint of the same instance
AUTH_URL=https://custody-auth-url/token

# API user keypair used to sign requests (private key is a secret)
PRIVATE_KEY=your-api-private-key
PUBLIC_KEY=your-api-public-key

# WebSocket URL of an XRPL node supporting confidential MPTs
XRPL_WSS_URL=wss://your-xrpl-node

# "true" to log every SDK request. Optional.
DEBUG=false