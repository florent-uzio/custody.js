{
  "name": "@florent-uzio/custody",
  "version": "3.0.0",
  "description": "An SDK to interact with the Ripple Custody API",
  "keywords": [
    "Custody",
    "Ripple Custody"
  ],
  "homepage": "https://github.com/florent-uzio/custody.js",
  "license": "MIT",
  "author": "Florent Uzio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florent-uzio/custody.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "add-changeset": "changeset",
    "build": "tsc",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "check-format": "oxfmt --check",
    "ci": "npm run build && npm run check-format && npm run lint && npm run typecheck:examples && npm run test",
    "dev": "vitest",
    "diff:openapi": "node ./scripts/diff-openapi.mjs",
    "fetch:openapi-spec": "node ./scripts/fetch-openapi-release.mjs",
    "format": "oxfmt",
    "generate:custody-types": "node ./scripts/generate-custody-types/generate.mjs && oxfmt ./src/models/custody-types.ts ./src/models/custody-internal-types.ts ./src/models/capabilities.generated.ts",
    "lint": "oxlint --type-aware src",
    "local-release": "changeset version && changeset publish",
    "prepare": "git config core.hooksPath .githooks || true && npm run build",
    "release": "changeset publish",
    "prepublishOnly": "npm run build && npm run check-format && npm run test",
    "sandbox": "tsx --env-file=.env sandbox/main.ts",
    "test": "vitest run --reporter verbose",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "canonicalize": "^3.0.0",
    "dayjs": "^1.11.21",
    "qs": "^6.16.0",
    "uuid": "^14.0.3",
    "xrpl": "^5.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^26.6.5",
    "@types/qs": "^6.15.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "dotenv": "^18.0.7",
    "lint-staged": "^17.6.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "src/**/*.ts": "oxlint --type-aware --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
