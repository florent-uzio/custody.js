{
  "name": "@florent-uzio/custody",
  "version": "2.13.0-beta.16",
  "description": "An SDK to interact with the Ripple Custody API",
  "keywords": [
    "Ripple Custody",
    "Custody"
  ],
  "homepage": "https://github.com/florent-uzio/custody.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florent-uzio/custody.js"
  },
  "license": "MIT",
  "author": "Florent Uzio",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "add-changeset": "changeset",
    "build": "tsc",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "check-format": "prettier --check .",
    "ci": "npm run build && npm run check-format && npm run lint && npm run typecheck:examples && npm run test",
    "dev": "vitest",
    "fetch:openapi-spec": "node ./scripts/fetch-openapi-release.mjs",
    "format": "prettier --write .",
    "generate:custody-types": "node ./scripts/generate-custody-types/generate.mjs && prettier --write ./src/models/custody-types.ts ./src/models/custody-internal-types.ts ./src/models/capabilities.generated.ts",
    "lint": "eslint src",
    "local-release": "changeset version && changeset publish",
    "prepare": "npm run build",
    "release": "changeset publish",
    "prepublishOnly": "npm run build && npm run check-format && npm run test",
    "sandbox": "tsx --env-file=.env sandbox/main.ts",
    "sort-package": "npx sort-package-json",
    "test": "vitest run --reporter verbose",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "canonicalize": "^3.0.0",
    "dayjs": "^1.11.21",
    "qs": "^6.15.3",
    "uuid": "^14.0.1",
    "xrpl": "^5.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^26.1.1",
    "@types/qs": "^6.15.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
